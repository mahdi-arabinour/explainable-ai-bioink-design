{
  "comments": [
    "8-R1",
    "17-R2",
    "18-R2"
  ],
  "random_seed": 42,
  "n_xai_repeats": 5,
  "n_permutations_per_heldout_fold": 10,
  "reference_models": {
    "Pr": {
